+
+/// All single-stroke lexical matches, before the UI filters by spelling and verb class.
+pub fn lookup_words(text: &str, rules: &RuleStore) -> Result<ReverseResult, ReverseError> {
+    use crate::ime::{SegmentKind, analyze};
+
+    if text.chars().count() > MAX_CHARS {
+        return Err(ReverseError::InputTooLong);
+    }
+    if text.is_empty() || !text.chars().all(is_hiragana) {
+        return Ok(ReverseResult::default());
+    }
+    let mut state = State::default();
+    state.mode = crate::Mode::Kana;
+    let end = text.chars().count();
+    let all = seeds(text, rules)
+        .into_iter()
+        .filter_map(|(raw, _)| {
+            let result = analyze(&raw, state, false, rules).ok()?;
+            if result.canonical_text.as_str() != text || result.translation.next.pending_sokuon() {
+                return None;
+            }
+            let [span] = result.segments() else {
+                return None;
+            };
+            let kind = match span.kind {
+                SegmentKind::Verb => Kind::Verb,
+                SegmentKind::GeneralAbbreviation => Kind::General,
+                _ => return None,
+            };
+            Some(Candidate {
+                strokes: raw,
+                segments: std::vec![Segment {
+                    start: 0,
+                    end,
+                    kind,
+                    lemma: None
+                }],
+                stroke_count: 1,
+            })
+        })
+        .collect();
+    Ok(ReverseResult {
+        all,
+        ..ReverseResult::default()
+    })
+}
+
 fn is_hiragana(c: char) -> bool {
     ('\u{3041}'..='\u{3096}').contains(&c) || matches!(c, 'ー' | '・' | '、' | '。' | '？')
 }
